<Layouts.app flash={@flash}>
  <.header>
    Checks
    <:subtitle>
      {length(@checks)} checks against {List.keyfind(@versions, @version, 0) |> elem(1)}.
    </:subtitle>
  </.header>

  <div role="tablist" class="tabs tabs-border" id="check-versions">
    <.link
      :for={{version, label} <- @versions}
      href={~p"/checks?spec_version=#{version}"}
      role="tab"
      id={"checks-v#{String.first(version)}"}
      class={["tab", version == @version && "tab-active"]}
    >
      {label}
    </.link>
  </div>

  <div class="overflow-x-auto">
    <.table id="checks" rows={@checks} row_id={&"check-#{&1.id}"}>
      <:col :let={check} label="Check"><code>{check.id}</code></:col>
      <:col :let={check} label="Section">§{check.section}</:col>
      <:col :let={check} label="Level">{check.level |> to_string() |> String.upcase()}</:col>
      <:col :let={check} label="Requirement">{check.title}</:col>
      <:col :let={check} label="Needs">{needs(check.requires)}</:col>
    </.table>
  </div>
</Layouts.app>
