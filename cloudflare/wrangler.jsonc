// The hosted runner: a Worker in front of the Phoenix release, which runs as a
// Cloudflare Container. Containers need the Workers Paid plan. See README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hcp-conformance",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "Runner",
      // The repository's own release image, the one CI smoke-tests.
      "image": "../Dockerfile",
      "image_build_context": "..",
      // 1/4 vCPU and 1 GiB: the release idles at about 100 MB.
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RUNNER", "class_name": "Runner" }]
  },
  "exports": {
    "Runner": { "type": "durable-object", "storage": "sqlite" }
  },
  // Secrets, set with `npx wrangler secret put NAME`: SECRET_KEY_BASE (required),
  // UI_BASIC_AUTH ("user:password", recommended on a public URL) and
  // REFERENCE_HOOK_SECRET. PHX_HOST is only needed on a custom domain.
  "vars": {
    "ALLOW_PRIVATE_TARGETS": "false",
    "MAX_CONCURRENT_RUNS": "4",
    "REFERENCE_SERVER": "true"
  }
}
