#!/bin/sh
# Runs the conformance suite from the release, with the CLI's flags:
#   bin/conformance --target https://vault.example.com --hook-url … --hook-secret …
set -e
SELF=$(readlink -f "$0" 2>/dev/null || echo "$0")
exec "$(dirname "$SELF")/hcp_conformance" eval "HcpConformance.CLI.main(System.argv())" "$@"
